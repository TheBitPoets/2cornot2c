# Generated policy: path-only access and process-only nginx logs are retained for 30 days.
# Incident/legal-hold evidence is preserved separately under the approved procedure.
@@ACCESS_LOG@@ @@ERROR_LOG@@ {
    daily
    rotate 30
    maxage 30
    missingok
    notifempty
    compress
    delaycompress
    create @@LOG_FILE_MODE@@ @@LOG_OWNER@@ @@LOG_GROUP@@
    sharedscripts
    postrotate
        pid_file=/run/nginx.pid
        if [ -f "$pid_file" ] && [ ! -L "$pid_file" ]; then
            pid="$(cat "$pid_file" 2>/dev/null || true)"
            case "$pid" in
                ''|*[!0-9]*) ;;
                *)
                    executable="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
                    command="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
                    uid="$(awk '/^Uid:/ { print $2; exit }' "/proc/$pid/status" 2>/dev/null || true)"
                    if [ "$executable" = /usr/sbin/nginx ] && [ "$uid" = 0 ]; then
                        case "$command" in
                            "nginx: master process "*) kill -USR1 "$pid" ;;
                        esac
                    fi
                    ;;
            esac
        fi
    endscript
}
