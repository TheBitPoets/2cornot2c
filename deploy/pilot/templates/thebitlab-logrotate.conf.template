# Generated policy: path-only access and process-only nginx logs are retained for 30 days.
# Incident/legal-hold evidence is preserved separately under the approved procedure.
@@ACCESS_LOG@@ @@ERROR_LOG@@ {
    daily
    rotate 30
    maxage 30
    missingok
    notifempty
    compress
    delaycompress
    create @@LOG_FILE_MODE@@ @@LOG_OWNER@@ @@LOG_GROUP@@
    sharedscripts
    postrotate
        # systemd owns the service identity. Never reinterpret nginx.pid as authority.
        state="$(systemctl is-active nginx.service 2>/dev/null)"
        result=$?
        case "$state:$result" in
            active:0)
                systemctl kill --kill-whom=main --signal=USR1 nginx.service
                ;;
            inactive:3)
                # A truly inactive unit has no open descriptors; the next start opens new files.
                ;;
            *)
                # failed/activating/deactivating/unknown and manager errors are ambiguous.
                exit 1
                ;;
        esac
    endscript
}
