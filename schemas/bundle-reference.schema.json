{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebitlab.dev/schemas/bundle-reference.schema.json",
  "title": "TheBitLab external bundle reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "version",
    "source_type",
    "source_url",
    "tag",
    "expected_commit_sha"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:[.](?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:[+][0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "source_type": {"const": "git"},
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?!(?:[0-9]+[.])+[0-9]+(?=[:/]))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:[.][A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::443)?(?:/(?![.]{1,2}(?:/|$))[A-Za-z0-9_.-]+){2,}(?![\\s\\S])"
    },
    "tag": {
      "type": "string",
      "pattern": "^v?(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:[.](?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:[+][0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "expected_commit_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    }
  }
}
