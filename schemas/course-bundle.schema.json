{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebitlab.dev/schemas/course-bundle.schema.json",
  "title": "TheBitLab course bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "school_year",
    "target_class",
    "language",
    "authors",
    "license",
    "content"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "#/$defs/slug"},
    "version": {"$ref": "#/$defs/semver"},
    "title": {"$ref": "#/$defs/nonEmptyString"},
    "school_year": {
      "type": "string",
      "pattern": "^[0-9]{4}/[0-9]{4}$"
    },
    "target_class": {"$ref": "#/$defs/nonEmptyString"},
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "platform_min_version": {
      "type": "string",
      "pattern": "^[0-9]{4}[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/author"}
    },
    "license": {"$ref": "#/$defs/nonEmptyString"},
    "price": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "content": {"$ref": "#/$defs/content"},
    "imports": {
      "type": "array",
      "items": {"$ref": "#/$defs/import"}
    },
    "local_extensions": {
      "type": "array",
      "items": {"$ref": "#/$defs/localExtension"}
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["price"],
        "properties": {"price": {"type": "integer"}}
      },
      "then": {"required": ["currency"]}
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:[.](?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:[+][0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"
    },
    "gitTag": {
      "type": "string",
      "pattern": "^v?(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:[.](?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:[+][0-9A-Za-z-]+(?:[.][0-9A-Za-z-]+)*)?$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "portablePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?!(?:[0-9]+[.])+[0-9]+(?=[:/]))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:[.][A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::443)?(?:/(?![.]{1,2}(?:/|$))[A-Za-z0-9_.-]+){2,}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "units": {
          "type": "array",
          "items": {"$ref": "#/$defs/unit"}
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "order": {"type": "integer", "minimum": 1},
        "activities": {"$ref": "#/$defs/pathList"},
        "materials": {"$ref": "#/$defs/pathList"},
        "media": {"$ref": "#/$defs/pathList"},
        "handouts": {"$ref": "#/$defs/pathList"}
      }
    },
    "pathList": {
      "type": "array",
      "items": {"$ref": "#/$defs/portablePath"}
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "version",
        "source_type",
        "source_url",
        "tag",
        "commit_sha"
      ],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/slug"},
        "version": {"$ref": "#/$defs/semver"},
        "source_type": {"const": "git"},
        "source_url": {"$ref": "#/$defs/sourceUrl"},
        "tag": {"$ref": "#/$defs/gitTag"},
        "commit_sha": {"$ref": "#/$defs/gitSha"},
        "all": {"const": true},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/importItem"}
        }
      },
      "oneOf": [
        {"required": ["all"], "not": {"required": ["items"]}},
        {"required": ["items"], "not": {"required": ["all"]}}
      ]
    },
    "importItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "target_path"],
      "properties": {
        "type": {
          "enum": ["activity", "material", "media", "handout"]
        },
        "path": {"$ref": "#/$defs/portablePath"},
        "target_path": {"$ref": "#/$defs/portablePath"},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target_path"],
      "properties": {
        "path": {"$ref": "#/$defs/portablePath"},
        "target_path": {"$ref": "#/$defs/portablePath"}
      }
    },
    "localExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "override_path"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*::[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "override_path": {"$ref": "#/$defs/portablePath"}
      }
    }
  }
}
